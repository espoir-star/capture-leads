        440,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Contacts ayant au moins un événement dans la fenêtre (sinon : rien à faire)\nconst ids = [...new Set($input.all().map((i) => Number(i.json.contact_id)).filter((v) => Number.isInteger(v) && v > 0))];\nreturn ids.map((contact_id) => ({ json: { contact_id } }));"
      },
      "id": "9211fa1b-f11c-4968-9a34-8c6d78d72e7d",
      "name": "Contacts actifs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "7IVWbyzYpzdvHA4W"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "contact_id",
              "condition": "eq",
              "keyValue": "={{ $json.contact_id }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "406838f3-488e-4897-9eb6-cf45c40e6d11",
      "name": "Historique complet",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Doublons du journal (insertions simultanées : la Data table n'a pas de contrainte d'unicité).\n// On garde la ligne la plus ancienne (plus petit id) de chaque clé ; les autres sont supprimées.\nconst first = new Map();\nconst extra = [];\nfor (const r of $input.all().map((i) => i.json).filter((r) => r && r.event_key && r.id !== undefined)) {\n  const k = r.event_key;\n  if (!first.has(k)) { first.set(k, r.id); continue; }\n  const keep = Math.min(first.get(k), r.id);\n  extra.push(Math.max(first.get(k), r.id));\n  first.set(k, keep);\n}\nreturn extra.map((id) => ({ json: { id } }));"
      },
      "id": "e160e201-0699-4fd6-9327-d5509e28a49e",
      "name": "Doublons du journal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        120
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "7IVWbyzYpzdvHA4W"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fad723e8-9c56-4b9d-8f86-d936193e37af",
      "name": "Supprimer les doublons",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1320,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lots de 500 lignes au plus pour /api/marketing/score ; l'historique d'un contact n'est jamais coupé.\nconst by = new Map();\nfor (const r of $input.all().map((i) => i.json).filter((r) => r && r.event_key)) {\n  if (!by.has(r.contact_id)) by.set(r.contact_id, []);\n  by.get(r.contact_id).push(({ event_key: r.event_key, contact_id: r.contact_id, category: r.category, points: r.points, occurred_at: r.occurred_at }));\n}\nconst out = [];\nlet batch = [];\nfor (const rows of by.values()) {\n  if (batch.length && batch.length + rows.length > 500) { out.push({ json: { rows: batch } }); batch = []; }\n  batch.push(...rows);\n}\nif (batch.length) out.push({ json: { rows: batch } });\nreturn out;"
      },
      "id": "ffaf36c8-90b7-4bd3-b955-19b0e1e3b533",
      "name": "Lots pour Vercel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
