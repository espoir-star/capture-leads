            {
              "id": "c8d37bf0-c7d0-4add-a856-e33f580f33a0",
              "name": "webinarSlug",
              "value": "slug-du-webinar",
              "type": "string"
            },
            {
              "id": "2b1ee7f2-0fb5-4d50-bdfd-6fe21aa53593",
