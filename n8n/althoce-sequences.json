      "id": "8a9d70f8-ad64-410c-a792-6c7f1375c406",
      "name": "Config — Paramètres des séquences",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
