        "url": "={{ $('Config — Paramètres des séquences').first().json.stepUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ enrollmentId: $json.enrollmentId, stepId: $json.stepId }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "070d087a-a907-4cb3-b8e8-a94b9b99c3f7",
      "name": "Exécuter l'étape (Vercel)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Fvh73Wb5raBHpxBa",
          "name": "Althoce · n8n → Vercel (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Réponse de /api/sequences/step (lib/sequences/run.ts) : Vercel décide, n8n ne fait qu'attendre.\nconst cfg = $('Config — Paramètres des séquences').first().json;\nconst r = $json;\nconst body = r && typeof r.body === 'object' && r.body !== null ? r.body : {};\nconst code = typeof r.statusCode === 'number' ? r.statusCode : 0; // 0 = réseau / timeout\nlet prev = {};\ntry { prev = $(\"Attendre l'étape\").last().json; } catch (e) { prev = {}; }\nconst enrollmentId = body.enrollmentId ?? prev.enrollmentId;\nconst stepId = body.requestedStepId ?? prev.stepId;\nconst attempts = Number(prev.attempts ?? 0);\n\nif (code === 200 && body.action === 'wait' && body.stepId && body.at) {\n  return [{ json: { route: 'wait', enrollmentId, stepId: body.stepId, at: body.at, attempts: 0 } }];\n}\nif (code === 200 && body.action === 'done') {\n  return [{ json: { route: 'done', enrollmentId, stepId, reason: body.reason ?? 'done' } }];\n}\n// Vercel ou Brevo indisponible : nouvel essai plus tard (sans risque : idempotence Brevo)\nconst retryable = code === 0 || code === 429 || code >= 500;\nif (retryable && attempts < cfg.maxAttempts) {\n  const at = new Date(Date.now() + cfg.retryDelayMinutes * 60 * 1000).toISOString();\n  return [{ json: { route: 'wait', enrollmentId, stepId, at, attempts: attempts + 1 } }];\n}\nreturn [{ json: { route: 'error', enrollmentId, stepId, statusCode: code, reason: body.reason ?? body.action ?? 'unknown' } }];"
      },
