# Aucune valeur secrète dans ce fichier. Valeurs réelles : Vercel → Settings → Environment Variables.
# « Prod » = obligatoire en Production (le build échoue sinon, voir next.config.mjs).

# ─── Brevo ─────────────────────────────────────────────── Prod : obligatoire
# Clé API v3, serveur uniquement. Brevo : Profil → SMTP & API → Clés API.
BREVO_API_KEY=

# ─── Cloudflare Turnstile (anti-bot) ───────────────────── Prod : obligatoires
# Cloudflare → Turnstile → Add widget (mode Managed) ; domaines : guide-gratuit-pi.vercel.app
# (+ *.vercel.app pour les Preview, + domaine personnalisé éventuel).
# Toujours les DEUX ensemble. Absentes (local / Preview) : Turnstile désactivé,
# honeypot + rate limiting restent actifs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Secret de signature ───────────────────────────────── Prod : obligatoire
# Signe le jeton « guide ouvert » et chiffre les liens « Confirmer mon adresse ».
# Valeur longue et aléatoire (openssl rand -hex 32), STABLE : la changer
# invalide les liens de confirmation déjà envoyés. Absent : dérivé de BREVO_API_KEY.
SIGNING_SECRET=

# ─── Webhook Brevo (hard bounce → EMAIL_STATUS = BOUNCED) ─── optionnel
# openssl rand -hex 32 ; même valeur dans la configuration du webhook Brevo (auth Bearer).
# Vide : /api/webhooks/brevo répond 404.
BREVO_WEBHOOK_SECRET=

# ─── Traceurs non essentiels (chargés seulement après « Tout accepter ») ───
# Google Analytics 4 (identifiant public). Non définie = valeur par défaut du code ; définie vide = GA désactivé.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W5TVSFJ2YX
# Meta Pixel (identifiant public). Non définie = valeur par défaut du code ; définie vide = Meta désactivé.
NEXT_PUBLIC_META_PIXEL_ID=1102300042365707
# Tracker Brevo : clé client publique (Brevo → Automation → Paramètres). Vide = désactivé.
NEXT_PUBLIC_BREVO_CLIENT_KEY=

# ─── Tests uniquement ──────────────────────────────────────────────────
# Faux Brevo local (tests/e2e). INTERDIT en Production (le build échoue).
# BREVO_API_BASE_URL=http://127.0.0.1:4010/v3

# ─── Moteur de séquences (Vercel + n8n) ─── docs/PHASE_MARKETING_N8N.md
# Bascule explicite, guide par guide (slugs séparés par des virgules). Vide = tous
# les guides restent livrés par leur automation Brevo historique.
ALTHOCE_SEQUENCE_GUIDES=
# Mode QA (« slug:qa » dans ALTHOCE_SEQUENCE_GUIDES) : adresses de test autorisées, et
# facteur d'accélération des délais (120 → relance J+2 après 24 min). Jamais pour de vrais prospects.
ALTHOCE_SEQUENCE_QA_EMAILS=
ALTHOCE_SEQUENCE_QA_TIME_SCALE=
# "true" = étapes différées reportées (pause d'urgence) ; la livraison immédiate continue.
ALTHOCE_SEQUENCES_PAUSED=
# Webhook de production du workflow n8n « ALTHOCE | Marketing | Séquences guides et webinars — v1 ».
N8N_SEQUENCE_WEBHOOK_URL=
# Jeton envoyé par Vercel à n8n (credential Header Auth du webhook). openssl rand -hex 32
N8N_WEBHOOK_TOKEN=
# Jeton envoyé par n8n à Vercel (/api/sequences/*, /api/marketing/score, /api/marketing/maintenance). openssl rand -hex 32
SEQUENCE_API_SECRET=
# Scoring comportemental : webhook du workflow « ALTHOCE | Marketing | Journal des événements — v1 »
# (https://n8n.srv1242605.hstgr.cloud/webhook/althoce-marketing-events). Vide = scoring comportemental désactivé.
N8N_EVENTS_WEBHOOK_URL=
# Domaine des liens dans les emails (défaut : URL de branche en Preview, sinon Production).
SITE_URL=
# Création de campagnes newsletter autorisée seulement après revue des segments 7/8/9.
MARKETING_SEGMENTS_REVIEWED=
# Offre Brevo payante uniquement : envoyer le tag des campagnes newsletter (refusé par Brevo Free).
BREVO_CAMPAIGN_TAGS=
