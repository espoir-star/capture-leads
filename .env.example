# Aucune valeur secrète dans ce fichier. Valeurs réelles : Vercel → Settings → Environment Variables.
# « Prod » = obligatoire en Production (le build échoue sinon, voir next.config.mjs).

# ─── Brevo ─────────────────────────────────────────────── Prod : obligatoire
# Clé API v3, serveur uniquement. Brevo : Profil → SMTP & API → Clés API.
BREVO_API_KEY=

# ─── Cloudflare Turnstile (anti-bot) ───────────────────── Prod : obligatoires
# Cloudflare → Turnstile → Add widget (mode Managed) ; domaines : guide-gratuit-pi.vercel.app
# (+ *.vercel.app pour les Preview, + domaine personnalisé éventuel).
# Toujours les DEUX ensemble. Absentes (local / Preview) : Turnstile désactivé,
# honeypot + rate limiting restent actifs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Secret de signature ───────────────────────────────── Prod : obligatoire
# Signe le jeton « guide ouvert » et chiffre les liens « Confirmer mon adresse ».
# Valeur longue et aléatoire (openssl rand -hex 32), STABLE : la changer
# invalide les liens de confirmation déjà envoyés. Absent : dérivé de BREVO_API_KEY.
SIGNING_SECRET=

# ─── Webhook Brevo ─────────────────────────────────────── optionnel
# openssl rand -hex 32 ; même valeur dans le webhook Brevo (auth Bearer).
# Vide : /api/webhooks/brevo répond 404.
BREVO_WEBHOOK_SECRET=

# ─── Traceurs non essentiels (chargés seulement après « Tout accepter ») ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W5TVSFJ2YX
NEXT_PUBLIC_META_PIXEL_ID=1102300042365707
NEXT_PUBLIC_BREVO_CLIENT_KEY=

# ─── Tests uniquement ──────────────────────────────────────────────────
# Faux Brevo local (tests/e2e). INTERDIT en Production.
# BREVO_API_BASE_URL=http://127.0.0.1:4010/v3

# ─── Moteur de séquences ─── docs/PHASE_MARKETING_N8N.md
# Slugs séparés par virgules. Vide = automations Brevo historiques.
ALTHOCE_SEQUENCE_GUIDES=
# « slug:qa » : adresses autorisées et délais accélérés, jamais pour les prospects.
ALTHOCE_SEQUENCE_QA_EMAILS=
ALTHOCE_SEQUENCE_QA_TIME_SCALE=
ALTHOCE_SEQUENCES_PAUSED=
N8N_SEQUENCE_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
SEQUENCE_API_SECRET=
N8N_EVENTS_WEBHOOK_URL=
SITE_URL=
MARKETING_SEGMENTS_REVIEWED=
BREVO_CAMPAIGN_TAGS=

# ─── Suivi multi-guides ─── docs/MULTI_GUIDES.md
# Vide = désactivé (aucun nouvel attribut écrit), qa = uniquement les adresses
# ALTHOCE_SEQUENCE_QA_EMAILS, on = toutes les captures après recette.
# Créer/vérifier d'abord les attributs :
# npx tsx --tsconfig tsconfig.json scripts/brevo/setup-multi-guides.ts
# --apply uniquement après contrôle. Ne change PAS la bascule des guides :
# ALTHOCE_SEQUENCE_GUIDES reste indépendant (risque de double automation).
ALTHOCE_MULTI_GUIDES=
