{
  "name": "althoce-ressources",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node scripts/test-analytics.mjs",
    "test:e2e": "tsx tests/e2e/run.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "brevo:attributes": "tsx --env-file-if-exists=.env scripts/brevo/setup-attributes.ts",
    "brevo:backfill": "tsx --env-file-if-exists=.env scripts/brevo/backfill.ts",
    "brevo:smoke": "tsx --env-file-if-exists=.env scripts/brevo/smoke-test.ts",
    "newsletter": "tsx --env-file-if-exists=.env scripts/newsletter/campaign.ts",
    "utm": "tsx scripts/tracking/build-url.ts",
    "data:disposable": "tsx scripts/data-quality/update-disposable-domains.ts",
    "brevo:segments": "tsx --env-file-if-exists=.env scripts/brevo/segments.ts",
    "brevo:webhooks": "tsx --env-file-if-exists=.env scripts/brevo/setup-webhooks.ts",
    "brevo:delete-test-contact": "tsx --env-file-if-exists=.env scripts/brevo/delete-test-contact.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "libphonenumber-js": "^1.13.14",
    "marked": "^18.1.0",
    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
